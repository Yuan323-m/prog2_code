        private void btnRemove_Click(object sender, EventArgs e)
        {
            if (lstYourPlaylist.SelectedItems.Count > 0)
            {
                // ma remove ung ni click mo
                lstYourPlaylist.SelectedItems[0].Remove();

                // 2. Fix the track numbers (#) so they are sequential again
                // i represents the index of each item in the list (starts at 0)
                for (int i = 0; i < lstYourPlaylist.Items.Count; i++)
                {
                    // Update the first column text to match its new position (1-based index)
                    lstYourPlaylist.Items[i].Text = (i + 1).ToString();
                }
            }
            else
            {
                MessageBox.Show("Please select a track inside your playlist to delete!", "No Song Highlighted", MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

        private void btnSavePlaylist_Click(object sender, EventArgs e)
        {
            // incase walang laman ung yourplaylist tapos sinubukan i save lilitaw to
            if (lstYourPlaylist.Items.Count == 0)
            {
                MessageBox.Show("Your playlist is empty!");
                return;
            }

            // para may nakalagay na Playlist 1(or etc. kung ilan man yan)
            lbMySavedPlaylist.Items.Add(string.Format("--- Playlist {0} ---", playlistCounter));

            // 
            foreach (ListViewItem item in lstYourPlaylist.Items)
            {
                string number = item.Text;
                string title = item.SubItems[1].Text;
                string artist = item.SubItems[2].Text;

                // ung number, title, artist lilitaw sya 
                lbMySavedPlaylist.Items.Add(string.Format("{0} - {1} - {2}", number, title, artist));
            }

            // para ma clear ung laman nung listview
            lstYourPlaylist.Items.Clear();

            // eto para hindi lang playlist 1 lagi nakalagay depende kung ilan dadag-dag nalang sya
            playlistCounter++;

            MessageBox.Show("Playlist saved successfully!");
        }
        private void btnAddToPlaylist_Click(object sender, EventArgs e)
        {
            if (lstAvailableSongs.SelectedItems.Count > 0)
            {
                ListViewItem selectedItem = lstAvailableSongs.SelectedItems[0];

                // kukuhanin nya anong nakasulat dun sa your playlist
                string title = selectedItem.SubItems[0].Text;
                string artist = selectedItem.SubItems[1].Text;
                string genre = selectedItem.SubItems[2].Text;
                string time = selectedItem.SubItems[3].Text;

                // gagawa ng new row para sa playlist
                ListViewItem newItem = new ListViewItem((lstYourPlaylist.Items.Count + 1).ToString());

                // ilalagay nya sa listbox ng tama ung order per column
                newItem.SubItems.Add(title);
                newItem.SubItems.Add(artist);
                newItem.SubItems.Add(genre);
                newItem.SubItems.Add(time);

                // ung ni click mong song sa available song mapupunta sya sa YourPlaylist pag ni click ung "add to Playlist"
                lstYourPlaylist.Items.Add(newItem);

                // lilitaw sa listbox na RECENT UPDATES ung time, title, genre, duration(time nung song)
                string logEntry = "[" + DateTime.Now.ToString("HH:mm:ss") + "] Added '" + title + "', " + genre + ", " + time;
                lstRecentActions.Items.Insert(0, logEntry);
            }
        }
